<svg viewBox="0 0 800 1000" xmlns="http://www.w3.org/2000/svg">
  <!-- Title -->
  <text x="400" y="30" font-size="20" font-weight="bold" text-anchor="middle" fill="#333">
    INTEGRISANI TELESKOPSKI Z-AXIS GRIP KONCEPT
  </text>
  
  <!-- Left side - COMPRESSED state -->
  <g id="compressed">
    <text x="200" y="70" font-size="16" font-weight="bold" text-anchor="middle" fill="#d63031">
      SKUPLJEN (pad)
    </text>
    
    <!-- Camera -->
    <rect x="150" y="90" width="100" height="60" fill="#34495e" stroke="#2c3e50" stroke-width="2"/>
    <text x="200" y="125" font-size="12" text-anchor="middle" fill="#ecf0f1">KAMERA</text>
    
    <!-- Gimbal motor housing -->
    <rect x="170" y="150" width="60" height="40" fill="#7f8c8d" stroke="#2c3e50" stroke-width="2"/>
    <circle cx="190" cy="170" r="8" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    <circle cx="210" cy="170" r="8" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    <text x="200" y="205" font-size="10" text-anchor="middle" fill="#555">GIMBAL MOTORI</text>
    
    <!-- Main grip body - OUTER -->
    <rect x="165" y="190" width="70" height="180" rx="10" fill="#95a5a6" stroke="#2c3e50" stroke-width="3"/>
    <text x="200" y="280" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">VANJSKA</text>
    <text x="200" y="295" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">CIJEV</text>
    
    <!-- Inner telescopic part - SHORT -->
    <rect x="175" y="340" width="50" height="30" rx="5" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
    <text x="200" y="358" font-size="9" text-anchor="middle" fill="#ecf0f1" font-weight="bold">INNER</text>
    
    <!-- Motor/actuator indication -->
    <rect x="180" y="220" width="40" height="25" rx="3" fill="#e67e22" stroke="#d35400" stroke-width="2"/>
    <text x="200" y="235" font-size="8" text-anchor="middle" fill="#fff">MOTOR</text>
    
    <!-- Hand grip texture -->
    <line x1="165" y1="250" x2="235" y2="250" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="165" y1="260" x2="235" y2="260" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="165" y1="270" x2="235" y2="270" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="165" y1="310" x2="235" y2="310" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="165" y1="320" x2="235" y2="320" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="165" y1="330" x2="235" y2="330" stroke="#7f8c8d" stroke-width="1"/>
    
    <!-- Arrows showing compression -->
    <path d="M 120 280 L 150 280" stroke="#d63031" stroke-width="3" fill="none" marker-end="url(#arrowred)"/>
    <path d="M 250 280 L 280 280" stroke="#d63031" stroke-width="3" fill="none" marker-end="url(#arrowred)"/>
    <text x="95" y="285" font-size="11" fill="#d63031" font-weight="bold">TLAK</text>
    <text x="283" y="285" font-size="11" fill="#d63031" font-weight="bold">TLAK</text>
  </g>
  
  <!-- Right side - EXTENDED state -->
  <g id="extended">
    <text x="600" y="70" font-size="16" font-weight="bold" text-anchor="middle" fill="#27ae60">
      IZVUČEN (lift)
    </text>
    
    <!-- Camera -->
    <rect x="550" y="90" width="100" height="60" fill="#34495e" stroke="#2c3e50" stroke-width="2"/>
    <text x="600" y="125" font-size="12" text-anchor="middle" fill="#ecf0f1">KAMERA</text>
    
    <!-- Gimbal motor housing -->
    <rect x="570" y="150" width="60" height="40" fill="#7f8c8d" stroke="#2c3e50" stroke-width="2"/>
    <circle cx="590" cy="170" r="8" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    <circle cx="610" cy="170" r="8" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    
    <!-- Main grip body - OUTER -->
    <rect x="565" y="190" width="70" height="180" rx="10" fill="#95a5a6" stroke="#2c3e50" stroke-width="3"/>
    <text x="600" y="280" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">VANJSKA</text>
    <text x="600" y="295" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">CIJEV</text>
    
    <!-- Motor/actuator -->
    <rect x="580" y="220" width="40" height="25" rx="3" fill="#e67e22" stroke="#d35400" stroke-width="2"/>
    <text x="600" y="235" font-size="8" text-anchor="middle" fill="#fff">MOTOR</text>
    
    <!-- Hand grip texture -->
    <line x1="565" y1="250" x2="635" y2="250" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="565" y1="260" x2="635" y2="260" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="565" y1="270" x2="635" y2="270" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="565" y1="310" x2="635" y2="310" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="565" y1="320" x2="635" y2="320" stroke="#7f8c8d" stroke-width="1"/>
    <line x1="565" y1="330" x2="635" y2="330" stroke="#7f8c8d" stroke-width="1"/>
    
    <!-- Inner telescopic part - EXTENDED -->
    <rect x="575" y="370" width="50" height="80" rx="5" fill="#3498db" stroke="#2980b9" stroke-width="2"/>
    <text x="600" y="395" font-size="9" text-anchor="middle" fill="#ecf0f1" font-weight="bold">INNER</text>
    <text x="600" y="408" font-size="9" text-anchor="middle" fill="#ecf0f1" font-weight="bold">CIJEV</text>
    <text x="600" y="421" font-size="9" text-anchor="middle" fill="#ecf0f1" font-weight="bold">(izvučena)</text>
    
    <!-- Extension arrows -->
    <path d="M 600 345 L 600 365" stroke="#27ae60" stroke-width="3" fill="none" marker-end="url(#arrowgreen)"/>
    <text x="615" y="357" font-size="11" fill="#27ae60" font-weight="bold">IZVLAČI</text>
  </g>
  
  <!-- Bottom - CROSS SECTION view -->
  <g id="crosssection">
    <text x="400" y="500" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">
      POPREČNI PRESJEK (odozgo)
    </text>
    
    <!-- Outer cylinder -->
    <circle cx="400" cy="580" r="80" fill="#bdc3c7" stroke="#2c3e50" stroke-width="3"/>
    <text x="400" y="680" font-size="12" text-anchor="middle" fill="#555">VANJSKA CIJEV (grip)</text>
    
    <!-- Inner cylinder -->
    <circle cx="400" cy="580" r="50" fill="#3498db" stroke="#2980b9" stroke-width="3"/>
    <text x="400" y="535" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">UNUTRAŠNJA</text>
    <text x="400" y="550" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">KLIZNA CIJEV</text>
    
    <!-- Motor components around -->
    <rect x="340" y="575" width="20" height="10" rx="2" fill="#e67e22" stroke="#d35400" stroke-width="1"/>
    <rect x="440" y="575" width="20" height="10" rx="2" fill="#e67e22" stroke="#d35400" stroke-width="1"/>
    <text x="295" y="582" font-size="9" fill="#d35400">linearni</text>
    <text x="295" y="593" font-size="9" fill="#d35400">actuator</text>
    
    <!-- Sensors -->
    <circle cx="370" cy="620" r="6" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    <circle cx="430" cy="620" r="6" fill="#e74c3c" stroke="#c0392b" stroke-width="1"/>
    <text x="400" y="645" font-size="9" text-anchor="middle" fill="#c0392b">IMU senzori</text>
    
    <!-- Wiring -->
    <path d="M 350 600 Q 340 610 340 625" stroke="#f39c12" stroke-width="2" fill="none" stroke-dasharray="3,3"/>
    <path d="M 450 600 Q 460 610 460 625" stroke="#f39c12" stroke-width="2" fill="none" stroke-dasharray="3,3"/>
    <text x="465" y="635" font-size="9" fill="#f39c12">kabli</text>
  </g>
  
  <!-- Technical notes -->
  <g id="notes">
    <text x="50" y="750" font-size="13" font-weight="bold" fill="#333">KOMPONENTE:</text>
    
    <circle cx="60" cy="775" r="5" fill="#e67e22"/>
    <text x="75" y="780" font-size="11" fill="#555">Linearni motor/actuator (voice coil ili servo)</text>
    
    <circle cx="60" cy="800" r="5" fill="#e74c3c"/>
    <text x="75" y="805" font-size="11" fill="#555">IMU senzori (akcelerometar + žiroskop)</text>
    
    <circle cx="60" cy="825" r="5" fill="#3498db"/>
    <text x="75" y="830" font-size="11" fill="#555">Unutrašnja teleskopska cijev (aluminij/carbon)</text>
    
    <circle cx="60" cy="850" r="5" fill="#95a5a6"/>
    <text x="75" y="855" font-size="11" fill="#555">Vanjski grip sa vodilicama i zaptivačima</text>
    
    <text x="50" y="890" font-size="13" font-weight="bold" fill="#333">PRINCIP RADA:</text>
    <text x="50" y="910" font-size="11" fill="#555">• Senzori detektuju vertikalno kretanje operatera</text>
    <text x="50" y="928" font-size="11" fill="#555">• Algoritam predviđa smjer i intenzitet pokreta</text>
    <text x="50" y="946" font-size="11" fill="#555">• Motor aktivno pomjera unutrašnju cijev u suprotnom smjeru</text>
    <text x="50" y="964" font-size="11" fill="#555">• Kamera ostaje stabilna u Z-osi (gore-dolje)</text>
    <text x="50" y="982" font-size="11" fill="#555">• Real-time kompenzacija (latencija &lt;10ms)</text>
  </g>
  
  <!-- Arrow markers -->
  <defs>
    <marker id="arrowred" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#d63031"/>
    </marker>
    <marker id="arrowgreen" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#27ae60"/>
    </marker>
  </defs>
</svg>