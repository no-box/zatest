<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <style>
    .line {
      fill: none;
      stroke: #000;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .screen-fill {
      fill: #fff;
      stroke: #000;
      stroke-width: 1.5;
    }
    @keyframes pulse {
      0% { transform: translate(0,0); }
      50% { transform: translate(-2px, -1px); }
      100% { transform: translate(0,0); }
    }
    .rigged-camera {
      transform-origin: center;
      animation: pulse 6s ease-in-out infinite;
    }
  </style>

  <!-- Background -->
  <rect width="100%" height="100%" fill="#fff"/>

  <!-- Camera Body (Back View, 3D Oblique Perspective) -->
  <g class="rigged-camera" transform="translate(800,450) scale(1.2)">
    <!-- Main body (rear rectangle, skewed for 3D) -->
    <polygon class="line"
      points="-120,-90 
               -120,80 
               120,80 
               120,-40 
               60,-90"/>
    
    <!-- Top plate (top face) -->
    <polygon class="line"
      points="-120,-90 
               -60,-90 
               0,-40 
               0,80 
               -120,80"/>

    <!-- Right side panel (depth edge) -->
    <polygon class="line"
      points="120,80 
               180,50 
               180,-10 
               120,-40"/>

    <!-- Screen area (rectangle inset) -->
    <rect x="-80" y="-50" width="140" height="90" class="screen-fill"/>
    <polygon class="line" points="-80,-50 140,-50 140,90 -80,90"/>

    <!-- Screen content (simulate photo being taken) -->
    <image href="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=200&auto=format&fit=crop"
           x="-80" y="-50" width="140" height="90" preserveAspectRatio="xMidYMid slice"/>

    <!-- Viewfinder bump (on top surface) -->
    <rect x="-70" y="-85" width="20" height="10" class="line"/>

    <!-- Control dials (right side) -->
    <circle cx="130" cy="20" r="6" class="line"/>
    <circle cx="130" cy="40" r="6" class="line"/>

    <!-- Strap mount rings (left side) -->
    <circle cx="-110" cy="0" r="4" class="line"/>
    <circle cx="-110" cy="60" r="4" class="line"/>

    <!-- Labeling / branding (optional text as line art) -->
    <text x="-100" y="30" font-family="monospace" font-size="10" fill="#000">DSLR</text>
  </g>
</svg>