<svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="800" fill="#f8f9fa"/>
  
  <!-- Header -->
  <text x="600" y="60" font-size="32" font-weight="bold" text-anchor="middle" fill="#2c3e50">
    INTEGRATED Z-AXIS STABILIZATION
  </text>
  <text x="600" y="95" font-size="18" text-anchor="middle" fill="#7f8c8d">
    Next-Generation Gimbal Grip Technology
  </text>
  
  <!-- Divider line -->
  <line x1="200" y1="120" x2="1000" y2="120" stroke="#bdc3c7" stroke-width="2"/>
  
  <!-- PROBLEM section - Left side -->
  <g id="problem">
    <text x="300" y="170" font-size="20" font-weight="bold" text-anchor="middle" fill="#e74c3c">
      CURRENT SOLUTION
    </text>
    
    <!-- Traditional setup with external spring arm -->
    <g id="traditional">
      <!-- Camera -->
      <rect x="240" y="200" width="120" height="70" rx="5" fill="#34495e" stroke="#2c3e50" stroke-width="2"/>
      <text x="300" y="240" font-size="14" text-anchor="middle" fill="#ecf0f1">CAMERA</text>
      
      <!-- Gimbal body -->
      <rect x="265" y="270" width="70" height="100" rx="8" fill="#95a5a6" stroke="#2c3e50" stroke-width="2"/>
      
      <!-- EXTERNAL spring arm -->
      <path d="M 300 370 L 300 420 Q 300 450 330 450 L 380 450" 
            stroke="#e67e22" stroke-width="8" fill="none" stroke-linecap="round"/>
      <circle cx="390" cy="450" r="15" fill="#e67e22" stroke="#d35400" stroke-width="2"/>
      
      <!-- Spring coils visual -->
      <path d="M 305 380 Q 315 380 315 390 Q 315 400 305 400 Q 295 400 295 410 Q 295 420 305 420" 
            stroke="#f39c12" stroke-width="3" fill="none"/>
      
      <!-- Labels -->
      <text x="300" y="500" font-size="13" text-anchor="middle" fill="#e67e22" font-weight="bold">
        EXTERNAL ARM
      </text>
      
      <!-- Problems list -->
      <text x="150" y="540" font-size="14" fill="#c0392b">✗ Bulky design</text>
      <text x="150" y="565" font-size="14" fill="#c0392b">✗ Adds 30-40cm length</text>
      <text x="150" y="590" font-size="14" fill="#c0392b">✗ Passive damping only</text>
      <text x="150" y="615" font-size="14" fill="#c0392b">✗ External component</text>
    </g>
  </g>
  
  <!-- Arrow indicating transformation -->
  <g id="arrow">
    <path d="M 480 380 L 620 380" stroke="#3498db" stroke-width="6" fill="none" marker-end="url(#arrowblue)"/>
    <text x="550" y="370" font-size="16" font-weight="bold" text-anchor="middle" fill="#3498db">
      INNOVATION
    </text>
  </g>
  
  <!-- SOLUTION section - Right side -->
  <g id="solution">
    <text x="900" y="170" font-size="20" font-weight="bold" text-anchor="middle" fill="#27ae60">
      NEW CONCEPT
    </text>
    
    <!-- New integrated design -->
    <g id="integrated">
      <!-- Camera -->
      <rect x="840" y="200" width="120" height="70" rx="5" fill="#34495e" stroke="#2c3e50" stroke-width="2"/>
      <text x="900" y="240" font-size="14" text-anchor="middle" fill="#ecf0f1">CAMERA</text>
      
      <!-- Gimbal body with integrated system -->
      <rect x="865" y="270" width="70" height="160" rx="8" fill="#95a5a6" stroke="#2c3e50" stroke-width="3"/>
      
      <!-- Internal mechanism hint (no details!) -->
      <rect x="875" y="290" width="50" height="40" rx="4" fill="#3498db" opacity="0.3"/>
      <text x="900" y="315" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">
        ACTIVE
      </text>
      <text x="900" y="328" font-size="11" text-anchor="middle" fill="#2c3e50" font-weight="bold">
        SYSTEM
      </text>
      
      <!-- Movement indication -->
      <path d="M 850 360 L 830 360" stroke="#27ae60" stroke-width="3" marker-end="url(#arrowgreen)"/>
      <path d="M 950 360 L 970 360" stroke="#27ae60" stroke-width="3" marker-end="url(#arrowgreen)"/>
      
      <!-- Grip texture -->
      <line x1="870" y1="350" x2="930" y2="350" stroke="#7f8c8d" stroke-width="1.5"/>
      <line x1="870" y1="365" x2="930" y2="365" stroke="#7f8c8d" stroke-width="1.5"/>
      <line x1="870" y1="380" x2="930" y2="380" stroke="#7f8c8d" stroke-width="1.5"/>
      <line x1="870" y1="395" x2="930" y2="395" stroke="#7f8c8d" stroke-width="1.5"/>
      <line x1="870" y1="410" x2="930" y2="410" stroke="#7f8c8d" stroke-width="1.5"/>
      
      <!-- NO external parts -->
      <text x="900" y="460" font-size="13" text-anchor="middle" fill="#27ae60" font-weight="bold">
        ALL INTERNAL
      </text>
      
      <!-- Benefits list -->
      <text x="750" y="540" font-size="14" fill="#27ae60">✓ Compact form factor</text>
      <text x="750" y="565" font-size="14" fill="#27ae60">✓ No added length</text>
      <text x="750" y="590" font-size="14" fill="#27ae60">✓ Active compensation</text>
      <text x="750" y="615" font-size="14" fill="#27ae60">✓ Integrated solution</text>
      <text x="750" y="640" font-size="14" fill="#27ae60">✓ Premium feel</text>
    </g>
  </g>
  
  <!-- Bottom section - Key message -->
  <rect x="150" y="680" width="900" height="90" rx="10" fill="#ecf0f1" stroke="#3498db" stroke-width="3"/>
  
  <text x="600" y="715" font-size="18" font-weight="bold" text-anchor="middle" fill="#2c3e50">
    ELIMINATES EXTERNAL Z-AXIS COMPONENTS
  </text>
  <text x="600" y="745" font-size="15" text-anchor="middle" fill="#7f8c8d">
    Proprietary internal mechanism provides active vertical stabilization
  </text>
  <text x="600" y="765" font-size="13" text-anchor="middle" fill="#95a5a6" font-style="italic">
    Technical details available under NDA
  </text>
  
  <!-- Arrow markers -->
  <defs>
    <marker id="arrowblue" markerWidth="12" markerHeight="12" refX="10" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#3498db"/>
    </marker>
    <marker id="arrowgreen" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#27ae60"/>
    </marker>
  </defs>
</svg>